{
  "name": "green-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.mjs",
    "tirage": "tsx --env-file=.env scripts/tirage.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.6",
    "tsx": "4.19.2",
    "typescript": "5.5.3",
    "vitest": "2.1.8"
  }
}
