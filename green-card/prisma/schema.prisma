// Green Card — modèle de données (étape 1 : socle)
// En dev : SQLite. En production : passer provider = "postgresql" et DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une résidence (immeuble) gérée par CDC Habitat
model Residence {
  id        String     @id @default(cuid())
  nom       String
  adresse   String
  codePostal String
  ville     String
  logements Logement[]
  createdAt DateTime   @default(now())

  @@index([nom])
}

/// Un logement, identifié par son numéro d'UG (codification CDC Habitat)
model Logement {
  id          String          @id @default(cuid())
  ug          String          @unique /// normalisé : majuscules, sans espace
  batiment    String?
  residenceId String
  residence   Residence       @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  activation  CodeActivation?
  carte       Carte?
}

/// Code d'activation remis au locataire (courrier ou SMS). Stocké haché, usage unique.
model CodeActivation {
  id         String    @id @default(cuid())
  logementId String    @unique
  logement   Logement  @relation(fields: [logementId], references: [id], onDelete: Cascade)
  codeHash   String
  expireLe   DateTime
  utiliseLe  DateTime?
  tentatives Int       @default(0)
  createdAt  DateTime  @default(now())
}

/// La Green Card du foyer : une par logement
model Carte {
  id                  String        @id @default(cuid())
  logementId          String        @unique
  logement            Logement      @relation(fields: [logementId], references: [id], onDelete: Cascade)
  pseudo              String
  pinHash             String
  tentativesPin       Int           @default(0)
  bloqueeJusquA       DateTime?
  consentCGU          DateTime
  consentConsommation DateTime?     /// consentement optionnel au traitement des relevés de consommation
  activeeLe           DateTime      @default(now())
  sessions            Session[]
  progressions        Progression[]
  mouvements          MouvementPoints[]
  releves             Releve[]
  partiesTri          PartieTri[]
  astuces             Astuce[]
  votes               VoteAstuce[]
  signalements        SignalementAstuce[]
  trajets             Trajet[]
  actionsCirculaires  ActionCirculaire[]
  annonces            Annonce[]         @relation("AnnoncesPubliees")
  annoncesRecues      Annonce[]         @relation("AnnoncesRecues")
  interets            InteretAnnonce[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  expireLe  DateTime
  createdAt DateTime @default(now())
}

/// Les 10 défis du parcours = les 10 cases de la carte
model Defi {
  id           String        @id /// slug, ex. "compteur-malin"
  ordre        Int           @unique
  titre        String
  univers      String        /// energie | mode-de-vie | dechets | astuces | circulaire | collectif
  emoji        String
  accroche     String
  pointsBronze Int
  pointsArgent Int
  pointsOr     Int
  progressions Progression[]
}

/// Avancement d'une carte sur un défi (niveau atteint : 0 = non commencé, 1 bronze, 2 argent, 3 or)
model Progression {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  defiId    String
  defi      Defi     @relation(fields: [defiId], references: [id])
  niveau    Int      @default(0)
  majLe     DateTime @updatedAt

  @@unique([carteId, defiId])
}

/// Journal des GreenPoints (le solde = somme des mouvements)
model MouvementPoints {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  points    Int
  motif     String
  defiId    String?
  createdAt DateTime @default(now())

  @@index([carteId])
}

// ---------------------------------------------------------------------------
// Étape 2 : les jeux 1 (Compteur Malin), 6 (Tri Master) et 9 (Boîte à Astuces)
// ---------------------------------------------------------------------------

/// Relevé d'un compteur (eau en m³, gaz en m³, électricité en kWh). Daté par le serveur.
model Releve {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  type      String   /// eau | gaz | elec
  index     Float
  date      DateTime @default(now())

  @@index([carteId, type, date])
}

/// Une partie de Tri Master : les déchets tirés et les réponses sont gardés côté serveur.
model PartieTri {
  id        String    @id @default(cuid())
  carteId   String
  carte     Carte     @relation(fields: [carteId], references: [id], onDelete: Cascade)
  dechets   String    /// JSON : liste des identifiants de déchets
  reponses  String    @default("{}") /// JSON : { idDechet: bac }
  debut     DateTime  @default(now())
  fin       DateTime?
  score     Int?
  dureeMs   Int?

  @@index([carteId, debut])
}

/// Une astuce partagée avec les voisins de la résidence.
model Astuce {
  id           String              @id @default(cuid())
  carteId      String
  carte        Carte               @relation(fields: [carteId], references: [id], onDelete: Cascade)
  residenceId  String
  univers      String
  titre        String
  texte        String
  statut       String              @default("publiee") /// publiee | masquee
  createdAt    DateTime            @default(now())
  votes        VoteAstuce[]
  signalements SignalementAstuce[]

  @@index([residenceId, statut])
}

model VoteAstuce {
  astuceId  String
  astuce    Astuce   @relation(fields: [astuceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([astuceId, carteId])
}

model SignalementAstuce {
  astuceId  String
  astuce    Astuce   @relation(fields: [astuceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([astuceId, carteId])
}

// ---------------------------------------------------------------------------
// Jeux 5 (Mes Trajets Verts) et 8 (Seconde Vie)
// ---------------------------------------------------------------------------

/// Un trajet en mobilité douce ou partagée. Le jour (AAAA-MM-JJ, heure de Paris) est aujourd'hui ou hier.
model Trajet {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  mode      String
  km        Float
  motif     String
  jour      String
  co2Evite  Float
  createdAt DateTime @default(now())

  @@index([carteId, jour])
}

/// Une action « seconde vie » : achat d'occasion, réparation, don, revente, ou échange entre voisins.
model ActionCirculaire {
  id          String   @id @default(cuid())
  carteId     String
  carte       Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  type        String   /// occasion | reparation | don | revente | echange
  categorie   String
  description String?
  prixPaye    Float?
  prixNeuf    Float?
  co2Evite    Float
  annonceId   String?  /// renseigné pour un échange confirmé via le mur des voisins
  createdAt   DateTime @default(now())

  @@index([carteId, createdAt])
}

/// Une annonce du mur des voisins (don, troc ou prêt), visible dans la résidence.
model Annonce {
  id             String           @id @default(cuid())
  carteId        String
  carte          Carte            @relation("AnnoncesPubliees", fields: [carteId], references: [id], onDelete: Cascade)
  residenceId    String
  type           String           /// don | troc | pret
  categorie      String
  titre          String
  description    String           @default("")
  statut         String           @default("ouverte") /// ouverte | conclue | retiree
  beneficiaireId String?
  beneficiaire   Carte?           @relation("AnnoncesRecues", fields: [beneficiaireId], references: [id], onDelete: SetNull)
  concluLe       DateTime?
  createdAt      DateTime         @default(now())
  interets       InteretAnnonce[]

  @@index([residenceId, statut])
}

model InteretAnnonce {
  annonceId String
  annonce   Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([annonceId, carteId])
}
