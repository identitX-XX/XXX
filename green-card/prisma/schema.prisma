// Green Card — modèle de données (étape 1 : socle)
// En dev : SQLite. En production : passer provider = "postgresql" et DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une résidence (immeuble) gérée par CDC Habitat
model Residence {
  id        String     @id @default(cuid())
  nom       String
  adresse   String
  codePostal String
  ville     String
  logements Logement[]
  createdAt DateTime   @default(now())

  @@index([nom])
}

/// Un logement, identifié par son numéro d'UG (codification CDC Habitat)
model Logement {
  id          String          @id @default(cuid())
  ug          String          @unique /// normalisé : majuscules, sans espace
  batiment    String?
  residenceId String
  residence   Residence       @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  activation  CodeActivation?
  carte       Carte?
}

/// Code d'activation remis au locataire (courrier ou SMS). Stocké haché, usage unique.
model CodeActivation {
  id         String    @id @default(cuid())
  logementId String    @unique
  logement   Logement  @relation(fields: [logementId], references: [id], onDelete: Cascade)
  codeHash   String
  expireLe   DateTime
  utiliseLe  DateTime?
  tentatives Int       @default(0)
  createdAt  DateTime  @default(now())
}

/// La Green Card du foyer : une par logement
model Carte {
  id                  String        @id @default(cuid())
  logementId          String        @unique
  logement            Logement      @relation(fields: [logementId], references: [id], onDelete: Cascade)
  pseudo              String
  pinHash             String
  tentativesPin       Int           @default(0)
  bloqueeJusquA       DateTime?
  consentCGU          DateTime
  consentConsommation DateTime?     /// consentement optionnel au traitement des relevés de consommation
  activeeLe           DateTime      @default(now())
  sessions            Session[]
  progressions        Progression[]
  mouvements          MouvementPoints[]
  releves             Releve[]
  partiesTri          PartieTri[]
  astuces             Astuce[]
  votes               VoteAstuce[]
  signalements        SignalementAstuce[]
  trajets             Trajet[]
  actionsCirculaires  ActionCirculaire[]
  annonces            Annonce[]         @relation("AnnoncesPubliees")
  annoncesRecues      Annonce[]         @relation("AnnoncesRecues")
  interets            InteretAnnonce[]
  partiesGaspi        PartieGaspi[]
  douches             Douche[]
  engagement19        Engagement19?
  checkIns19          CheckIn19[]
  actionsAntiGaspi    ActionAntiGaspi[]
  quizFrigo           QuizFrigo[]
  defisImmeuble       MembreDefiImmeuble[]
  commandes           Commande[]
  participations      ParticipationTirage[]
  tiragesGagnes       Tirage[]          @relation("TiragesGagnes")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  expireLe  DateTime
  createdAt DateTime @default(now())
}

/// Les 10 défis du parcours = les 10 cases de la carte
model Defi {
  id           String        @id /// slug, ex. "compteur-malin"
  ordre        Int           @unique
  titre        String
  univers      String        /// energie | mode-de-vie | dechets | astuces | circulaire | collectif
  emoji        String
  accroche     String
  pointsBronze Int
  pointsArgent Int
  pointsOr     Int
  progressions Progression[]
}

/// Avancement d'une carte sur un défi (niveau atteint : 0 = non commencé, 1 bronze, 2 argent, 3 or)
model Progression {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  defiId    String
  defi      Defi     @relation(fields: [defiId], references: [id])
  niveau    Int      @default(0)
  majLe     DateTime @updatedAt

  @@unique([carteId, defiId])
}

/// Journal des GreenPoints (le solde = somme des mouvements)
model MouvementPoints {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  points    Int
  motif     String
  defiId    String?
  createdAt DateTime @default(now())

  @@index([carteId])
}

// ---------------------------------------------------------------------------
// Étape 2 : les jeux 1 (Compteur Malin), 6 (Tri Master) et 9 (Boîte à Astuces)
// ---------------------------------------------------------------------------

/// Relevé d'un compteur (eau en m³, gaz en m³, électricité en kWh). Daté par le serveur.
model Releve {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  type      String   /// eau | gaz | elec
  index     Float
  date      DateTime @default(now())

  @@index([carteId, type, date])
}

/// Une partie de Tri Master : les déchets tirés et les réponses sont gardés côté serveur.
model PartieTri {
  id        String    @id @default(cuid())
  carteId   String
  carte     Carte     @relation(fields: [carteId], references: [id], onDelete: Cascade)
  dechets   String    /// JSON : liste des identifiants de déchets
  reponses  String    @default("{}") /// JSON : { idDechet: bac }
  debut     DateTime  @default(now())
  fin       DateTime?
  score     Int?
  dureeMs   Int?

  @@index([carteId, debut])
}

/// Une astuce partagée avec les voisins de la résidence.
model Astuce {
  id           String              @id @default(cuid())
  carteId      String
  carte        Carte               @relation(fields: [carteId], references: [id], onDelete: Cascade)
  residenceId  String
  univers      String
  titre        String
  texte        String
  statut       String              @default("publiee") /// publiee | masquee
  createdAt    DateTime            @default(now())
  votes        VoteAstuce[]
  signalements SignalementAstuce[]

  @@index([residenceId, statut])
}

model VoteAstuce {
  astuceId  String
  astuce    Astuce   @relation(fields: [astuceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([astuceId, carteId])
}

model SignalementAstuce {
  astuceId  String
  astuce    Astuce   @relation(fields: [astuceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([astuceId, carteId])
}

// ---------------------------------------------------------------------------
// Jeux 5 (Mes Trajets Verts) et 8 (Seconde Vie)
// ---------------------------------------------------------------------------

/// Un trajet en mobilité douce ou partagée. Le jour (AAAA-MM-JJ, heure de Paris) est aujourd'hui ou hier.
model Trajet {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  mode      String
  km        Float
  motif     String
  jour      String
  co2Evite  Float
  createdAt DateTime @default(now())

  @@index([carteId, jour])
}

/// Une action « seconde vie » : achat d'occasion, réparation, don, revente, ou échange entre voisins.
model ActionCirculaire {
  id          String   @id @default(cuid())
  carteId     String
  carte       Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  type        String   /// occasion | reparation | don | revente | echange
  categorie   String
  description String?
  prixPaye    Float?
  prixNeuf    Float?
  co2Evite    Float
  annonceId   String?  /// renseigné pour un échange confirmé via le mur des voisins
  createdAt   DateTime @default(now())

  @@index([carteId, createdAt])
}

/// Une annonce du mur des voisins (don, troc ou prêt), visible dans la résidence.
model Annonce {
  id             String           @id @default(cuid())
  carteId        String
  carte          Carte            @relation("AnnoncesPubliees", fields: [carteId], references: [id], onDelete: Cascade)
  residenceId    String
  type           String           /// don | troc | pret
  categorie      String
  titre          String
  description    String           @default("")
  statut         String           @default("ouverte") /// ouverte | conclue | retiree
  beneficiaireId String?
  beneficiaire   Carte?           @relation("AnnoncesRecues", fields: [beneficiaireId], references: [id], onDelete: SetNull)
  concluLe       DateTime?
  createdAt      DateTime         @default(now())
  interets       InteretAnnonce[]

  @@index([residenceId, statut])
}

model InteretAnnonce {
  annonceId String
  annonce   Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([annonceId, carteId])
}

// ---------------------------------------------------------------------------
// Jeux 2 (Chasse au Gaspi), 3 (Douche Chrono), 4 (Opération 19 °C), 7 (Zéro Gaspi Frigo), 10 (Défi Immeuble)
// ---------------------------------------------------------------------------

/// Une partie de Chasse au Gaspi : l'ordre des objets et la solution restent côté serveur.
model PartieGaspi {
  id       String    @id @default(cuid())
  carteId  String
  carte    Carte     @relation(fields: [carteId], references: [id], onDelete: Cascade)
  objets   String    /// JSON : identifiants des objets, dans l'ordre affiché
  clics    String    @default("[]") /// JSON : objets déjà touchés
  trouves  Int       @default(0)
  erreurs  Int       @default(0)
  debut    DateTime  @default(now())
  fin      DateTime?
  dureeMs  Int?

  @@index([carteId, debut])
}

/// Une douche chronométrée : début et fin horodatés par le serveur.
model Douche {
  id      String    @id @default(cuid())
  carteId String
  carte   Carte     @relation(fields: [carteId], references: [id], onDelete: Cascade)
  debut   DateTime  @default(now())
  fin     DateTime?
  dureeS  Int?
  jour    String
  reussie Boolean   @default(false)

  @@index([carteId, jour])
}

/// Les engagements chauffage choisis par le foyer (Opération 19 °C).
model Engagement19 {
  carteId      String   @id
  carte        Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  engagements  String   /// JSON : identifiants des engagements
  majLe        DateTime @updatedAt
}

/// Le point du jour : engagements tenus ce jour-là.
model CheckIn19 {
  id      String   @id @default(cuid())
  carteId String
  carte   Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  jour    String
  faits   String   /// JSON : engagements tenus
  tenue   Boolean
  majLe   DateTime @updatedAt

  @@unique([carteId, jour])
}

/// Une action anti-gaspillage alimentaire (Zéro Gaspi Frigo).
model ActionAntiGaspi {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  type      String   /// recette | congele | partage | liste | compost
  recetteId String?
  jour      String
  createdAt DateTime @default(now())

  @@index([carteId, jour])
}

/// Une tentative au quiz « DLC ou DDM ? ».
model QuizFrigo {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@index([carteId])
}

/// Inscription d'un foyer au Défi Immeuble d'un mois donné (AAAA-MM).
model MembreDefiImmeuble {
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  mois      String
  createdAt DateTime @default(now())

  @@id([carteId, mois])
}

// ---------------------------------------------------------------------------
// Catalogue de cadeaux
// ---------------------------------------------------------------------------

/// Un cadeau : échangeable contre des GreenPoints (boutique) ou à gagner par tirage (grand prix).
model Cadeau {
  id          String     @id /// slug, ex. "mug"
  ordre       Int
  type        String     /// boutique | grand-prix
  nom         String
  description String
  prix        Int?       /// en GreenPoints (boutique)
  stock       Int?       /// exemplaires restants (boutique)
  tailles     String?    /// JSON : tailles proposées (tee-shirt)
  actif       Boolean    @default(true)
  commandes   Commande[]
  tirages     Tirage[]
}

/// Un cadeau commandé avec des GreenPoints. Retrait au bureau du gardien ou à l'agence avec le code.
model Commande {
  id        String   @id @default(cuid())
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  cadeauId  String
  cadeau    Cadeau   @relation(fields: [cadeauId], references: [id])
  taille    String?
  points    Int
  code      String   @unique
  statut    String   @default("a-preparer") /// a-preparer | prete | remise | annulee
  createdAt DateTime @default(now())

  @@index([carteId, statut])
}

/// Le grand tirage d'une saison.
model Tirage {
  id             String                @id /// ex. "saison-2026-2027"
  cadeauId       String
  cadeau         Cadeau                @relation(fields: [cadeauId], references: [id])
  libelle        String
  clotureLe      DateTime              /// fin des inscriptions et date du tirage
  gagnantId      String?
  gagnant        Carte?                @relation("TiragesGagnes", fields: [gagnantId], references: [id], onDelete: SetNull)
  effectueLe     DateTime?
  participations ParticipationTirage[]
}

model ParticipationTirage {
  tirageId  String
  tirage    Tirage   @relation(fields: [tirageId], references: [id], onDelete: Cascade)
  carteId   String
  carte     Carte    @relation(fields: [carteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tirageId, carteId])
}
